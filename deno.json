{
  "name": "@esroyo/web-cache-api-persistence",
  "version": "0.4.2",
  "exports": {
    ".": "./mod.ts",
    "./memory": "./src/memory/mod.ts",
    "./noop": "./src/noop/mod.ts",
    "./deno-kv": "./src/deno_kv/mod.ts",
    "./deno-redis": "./src/deno_redis/mod.ts",
    "./unstorage": "./src/unstorage/mod.ts"
  },
  "tasks": {
    "bench": "deno bench -A --unstable-kv bench/cache_persistence_bench.ts && rm -rf tmp/*",
    "coverage": "deno task test --clean --reporter=dot --coverage=coverage && deno coverage --lcov --output=coverage.lcov --exclude='src/core/test_utils.ts|vendor' coverage && genhtml -o coverage/report coverage.lcov",
    "fmt": "deno fmt src/",
    "release": "deno run -A npm:commit-and-tag-version && git push --follow-tags origin main && deno publish --allow-slow-types",
    "release:dry-run": "deno run -A npm:commit-and-tag-version --dry-run && deno publish --dry-run --allow-slow-types --allow-dirty",
    "test": "deno test -A --parallel --unstable-kv"
  },
  "publish": {
    "exclude": [
      "bench/",
      ".github/",
      "openspec/",
      ".editorconfig",
      ".versionrc.json",
      "redis.conf",
      "*_test.ts"
    ]
  },
  "imports": {
    "@db/redis": "jsr:@db/redis@0.41.2",
    "@jabr/xxhash64": "jsr:@jabr/xxhash64@2.0.0",
    "@kitsonk/kv-toolbox": "jsr:@kitsonk/kv-toolbox@0.30.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.0",
    "@std/assert": "jsr:@std/assert@1.0.6",
    "@std/async": "jsr:@std/async@1",
    "@std/http": "jsr:@std/http@1",
    "@std/testing": "jsr:@std/testing@1.0.5",
    "@std/ulid": "jsr:@std/ulid@1.0.0",
    "generic-pool": "jsr:@esroyo/generic-pool@3.10.4",
    "msgpack-lite": "npm:msgpack-lite@0.1.26",
    "sorted": "npm:sorted-array-functions@1.3.0",
    "ioredis": "npm:ioredis@5.5.0",
    "unstorage": "npm:unstorage@1.17.5"
  },
  "nodeModulesDir": "none"
}
